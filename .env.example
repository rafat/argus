GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
VERTEX_AI_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true

FIRESTORE_DATABASE=argus

GCS_BUCKET=YOUR_BUCKET_NAME

# Leave empty for local development (uses the in-process broker).
# In production use the fully-qualified topic resource name:
# projects/YOUR_PROJECT_ID/topics/document-uploaded
PUBSUB_DOCUMENT_UPLOADED_TOPIC=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# Managed production guardrail. Leave disabled locally unless the template and
# IAM permissions are configured.
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_PROJECT=YOUR_PROJECT_ID
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=argus-production

# Vector Search
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
VECTOR_SEARCH_LOCATION=us-central1
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_ENDPOINT_ID=
VECTOR_SEARCH_DEPLOYED_INDEX_ID=
VECTOR_SEARCH_INDEX_NAME=

# --------------------------------------------------
# Agent Retrieval / Vector Search 2.0
# --------------------------------------------------

AGENT_RETRIEVAL_LOCATION=us-central1
AGENT_RETRIEVAL_COLLECTION_ID=argusclaims

AGENT_RETRIEVAL_VECTOR_FIELD=claim_embedding
AGENT_RETRIEVAL_EMBEDDING_DIMENSIONS=3072
AGENT_RETRIEVAL_EMBEDDING_MODEL=gemini-embedding-001

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local macOS workaround for ADK async AFC/gRPC fork issues.
ARGUS_USE_ASYNC_GEMINI=false
ARGUS_AGENT_TIMEOUT_SECONDS=120
ARGUS_GEMINI_MODEL=gemini-3.5-flash

CONFLICT_CANDIDATE_TOP_K=5
